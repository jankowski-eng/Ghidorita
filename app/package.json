{
  "name": "ghidorita",
  "version": "0.0.1",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build && node scripts/build-fixture.mjs",
    "postinstall": "node scripts/dev-app.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "dist": "../packaging/prepare.sh && npm run build && electron-builder --mac dmg --arm64",
    "dist:fixture": "npm run build && electron-builder --config fixture.builder.cjs --mac dir --arm64",
    "dist:signed": "../packaging/prepare.sh && npm run build && electron-builder --mac dmg --arm64 --config.mac.identity=\"$SIGN_IDENTITY\" --config.mac.hardenedRuntime=true --config.mac.notarize=true --config.dmg.sign=true"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.28",
    "monaco-editor": "^0.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "li.jankowski.ghidorita",
    "productName": "Ghidorita",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!out/providers/**",
      "build/icon.png",
      "package.json",
      "!node_modules/{monaco-editor,@monaco-editor,react,react-dom,@tanstack}/**"
    ],
    "extraResources": [
      {
        "from": "bundle/jdk",
        "to": "jdk"
      },
      {
        "from": "bundle/ghidra",
        "to": "ghidra"
      },
      {
        "from": "bundle/python",
        "to": "python"
      },
      {
        "from": "bundle/sidecar",
        "to": "sidecar"
      },
      {
        "from": "out/providers/fixture.cjs",
        "to": "providers/fixture.cjs"
      },
      {
        "from": "bundle/THIRD_PARTY_NOTICES",
        "to": "THIRD_PARTY_NOTICES"
      },
      {
        "from": "bundle/BUILD_INFO.json",
        "to": "BUILD_INFO.json"
      }
    ],
    "mac": {
      "target": "dmg",
      "identity": "-",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "entitlements": "../packaging/entitlements.mac.plist",
      "entitlementsInherit": "../packaging/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "afterSign": "scripts/sign-nested.cjs"
  }
}
