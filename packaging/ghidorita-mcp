#!/bin/sh
# Runs the stdio bridge on the app's own Electron-as-Node: Resources/mcp/ghidorita-mcp -> Contents/MacOS/Ghidorita
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)
ELECTRON_RUN_AS_NODE=1 exec "$dir/../../MacOS/Ghidorita" "$dir/bridge.cjs" "$@"
